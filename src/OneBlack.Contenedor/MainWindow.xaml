<Window x:Class="OneBlack.Contenedor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:OneBlack.Core;assembly=OneBlack.Core"
        Title="OneBlack" Height="700" Width="1100"
        Icon="Recursos/oneblack.ico"
        Background="{StaticResource App}">

    <!-- Grid raíz: 3 filas → titlebar / cuerpo / statusbar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <!-- titlebar -->
            <RowDefinition Height="*"/>
            <!-- cuerpo -->
            <RowDefinition Height="28"/>
            <!-- statusbar -->
        </Grid.RowDefinitions>

        <!-- ===== TITLEBAR: pestañas + acciones ===== -->
        <Border Grid.Row="0" Background="{StaticResource Chrome}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- pestañas -->
                    <ColumnDefinition Width="*"/>
                    <!-- espacio flexible -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- acción provisoria -->
                </Grid.ColumnDefinitions>

                <!-- Pestañas: Cockpit fija + pestañas de IDE dinámicas -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

        
                    <!-- Pestaña Cockpit (fija). Su resaltado lo maneja el code-behind
                         (ResaltarCockpit), para que no quede siempre encendida. -->
                    <Button x:Name="btnCockpit" Style="{StaticResource TabButton}"
                            Foreground="{StaticResource Dim}"
                            Click="navCockpit_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}"
         VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Cockpit" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Pestañas dinámicas: una por ventana adoptada.
                         La activa se resalta vía el DataTrigger sobre EstaActiva. -->
                    <ItemsControl x:Name="barraPestañas">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Pestaña_Click" Cursor="Hand"
        AllowDrop="True"
        PreviewMouseLeftButtonDown="Pestaña_MouseDown"
        PreviewMouseMove="Pestaña_MouseMove"
        DragOver="Pestaña_DragOver">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="14,0" Height="32">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Color}"
         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                    <TextBlock x:Name="txt" Text="{Binding Titulo}"
                                                               Foreground="{StaticResource Dim}"
                                                               VerticalAlignment="Center" FontSize="12.5"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Hover: fondo sutil -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#111017"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Fg2}"/>
                                                </Trigger>
                                                <!-- ACTIVA: resaltada (fondo + borde violeta, texto claro).
                                                     Reacciona a EstaActiva, que ya se setea en ActivarPestaña. -->
                                                <DataTrigger Binding="{Binding EstaActiva}" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource TabBg}"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TabEdge}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Fg}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Botón "+" para agregar/adoptar ventana -->
                    <Button x:Name="botonAgregar" Style="{StaticResource TabButton}"
                            Content="+" FontSize="16" Padding="10,0"
                            Foreground="{StaticResource Dim}"
                            Click="botonAgregar_Click"
                            ToolTip="Nueva pestaña"/>
                </StackPanel>

                <!-- Acción provisoria (atajo de testeo) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▸ prueba" Style="{StaticResource TabButton}"
                            Foreground="{StaticResource Dim}"
                            Click="botonProyectoPrueba_Click"
                            ToolTip="Lanzar proyecto de prueba (provisorio)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CUERPO: sidebar + área central ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colSidebar" Width="212"/>
                <!-- sidebar -->
                <ColumnDefinition Width="*"/>
                <!-- área central -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR de identidad -->
            <Border Grid.Column="0" Background="{StaticResource Chrome}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8,16,8,12">

                    <!-- Cabecera: logo + wordmark + toggle -->
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,18">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Width="24" Height="24" CornerRadius="5"
                                    Background="{StaticResource Accent}"/>
                            <TextBlock x:Name="txtWordmark" Text="OneBlack"
                                       Foreground="{StaticResource Fg}"
                                       FontSize="13" FontFamily="Consolas"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="botonPlegar" Content="«"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource TabButton}"
                                Background="{StaticResource Panel}"
                                Foreground="{StaticResource Fg2}" Padding="8,2"
                                Click="botonPlegar_Click"/>
                    </Grid>

                    <!-- Pie: estado del hub -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                Margin="6,0" VerticalAlignment="Bottom">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource Data}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtHub" Text="one-hub"
                                   Foreground="{StaticResource Faint}"
                                   FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Navegación de espacios -->
                    <StackPanel x:Name="navEspacio">
                        <TextBlock x:Name="txtGrupoEspacio" Text="ESPACIO"
                                   Foreground="{StaticResource Ghost}"
                                   FontFamily="Consolas" FontSize="10" Margin="9,0,0,8"/>

                        <Button Style="{StaticResource SideItem}" Tag="C" Content="Cockpit"
                                Click="navCockpit_Click"/>
                        <Button Style="{StaticResource SideItem}" Tag="P" Content="Proyectos"
                                Click="navProyectos_Click"/>
                        <Button Style="{StaticResource SideItem}" Tag="G" Content="Git"
                                Click="navGit_Click"/>
                        <Button Style="{StaticResource SideItem}" Tag="A" Content="Ajustes"
                                Click="navAjustes_Click"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ÁREA CENTRAL: dos capas superpuestas.
                 Capa 1: el hueco del reparenting (IDEs adoptados).
                 Capa 2: las páginas propias de OneBlack (Cockpit, nueva pestaña).
                 Se muestra UNA a la vez; al mostrar una página propia, la ventana
                 adoptada se oculta (SW_HIDE) porque el IDE pinta encima de su región. -->
            <Grid Grid.Column="1" Margin="8">

                <!-- Capa 1: el hueco (IDEs). Enmarcado en violeta. -->
                <Border x:Name="marcoHueco"
                        BorderBrush="{StaticResource Accent}" BorderThickness="1">
                    <core:VentanaAnfitriona x:Name="anfitriona"/>
                </Border>

                <!-- Capa 2: contenedor de páginas propias. -->
                <ContentControl x:Name="areaPaginaPropia" Visibility="Collapsed"/>

            </Grid>
        </Grid>

        <!-- ===== STATUSBAR ===== -->
        <Border Grid.Row="2" Background="{StaticResource Chrome}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <TextBlock Text="feature/reservas" Foreground="{StaticResource Dim}"
                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  " Foreground="{StaticResource Faint}"
                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="textoEstado" Text="Listo."
                           Foreground="{StaticResource Dim}"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>