<UserControl x:Class="OneBlack.Contenedor.PaginaNuevaPestaña"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CodeBg}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock Text="Nueva pestaña" Foreground="{StaticResource Fg}"
                       FontSize="20" FontFamily="Consolas" HorizontalAlignment="Center"/>
            <TextBlock Text="Elegí un programa y una carpeta para empezar"
                       Foreground="{StaticResource Dim}" FontFamily="Consolas"
                       FontSize="13" Margin="0,8,0,24" HorizontalAlignment="Center"/>

            <!-- Esta es la parte clave: el ItemsControl con x:Name="listaApps" -->
            <ItemsControl x:Name="listaApps">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SideItem}" Tag="▸"
                                Content="{Binding NombreMostrado}"
                                Margin="0,3" Padding="12,0" Height="40"
                                Click="App_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="txtInfo" Text=""
                       Foreground="{StaticResource Faint}" FontFamily="Consolas"
                       FontSize="11" Margin="0,16,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>