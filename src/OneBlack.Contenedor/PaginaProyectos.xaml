<UserControl x:Class="OneBlack.Contenedor.PaginaProyectos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Botón secundario (Abrir / quitar) -->
        <Style x:Key="BotonChico" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="7" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B1A22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Botón primario (Nuevo proyecto) -->
        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="Foreground" Value="#0C0B10"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource App}">
        <Grid Margin="30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header -->
                <RowDefinition Height="*"/>
                <!-- lista -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="Proyectos" Foreground="{StaticResource Fg}"
                           FontSize="20" FontFamily="Consolas" VerticalAlignment="Center"/>
                <Button Content="+ Nuevo proyecto" HorizontalAlignment="Right"
                        Style="{StaticResource BotonPrimario}" Click="Nuevo_Click"/>
            </Grid>

            <!-- Lista de proyectos -->
            <Grid Grid.Row="1">
                <TextBlock x:Name="txtVacio"
                           Text="No hay proyectos guardados todavía. Creá uno con &quot;Nuevo proyecto&quot;."
                           Foreground="{StaticResource Faint}" FontSize="12.5"
                           FontFamily="Consolas" HorizontalAlignment="Center"
                           VerticalAlignment="Top" Margin="0,20,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="listaProyectos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Chrome}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="12" Height="12"
                                                 Fill="{Binding Color}" VerticalAlignment="Center"
                                                 Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}"
                                                       Foreground="{StaticResource Fg}" FontSize="14"/>
                                            <TextBlock Foreground="{StaticResource Dim}" FontSize="11"
                                                       FontFamily="Consolas" Margin="0,3,0,0"
                                                       Text="{Binding Carpetas.Count, StringFormat={}{0} carpeta(s)}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Abrir" Click="Abrir_Click"
                                                Style="{StaticResource BotonChico}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="3" Content="✕" Click="Eliminar_Click"
                                                Style="{StaticResource BotonChico}"
                                                ToolTip="Eliminar proyecto"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>