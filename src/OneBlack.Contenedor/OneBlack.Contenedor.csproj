<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Recursos\oneblack.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Recursos\oneblack.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneBlack.Core\OneBlack.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	  <ApplicationIcon>Recursos\oneblack.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
	<!-- Referencia al proyecto del janitor SOLO para forzar que se compile
       y se copie su .exe junto a OneBlack. ReferenceOutputAssembly=false
       evita que OneBlack intente usarlo como librería (es un .exe aparte). -->
	<ItemGroup>
		<ProjectReference Include="..\OneBlack.Janitor\OneBlack.Janitor.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Content</OutputItemType>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</ProjectReference>
	</ItemGroup>
</Project>
